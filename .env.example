# Copy to .env and fill in values for local development
# Expo SDK 56: only EXPO_PUBLIC_* vars are available in app code

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_API_TIMEOUT_MS=30000

# OAuth (expo-auth-session) — add when auth is wired up
EXPO_PUBLIC_AUTH_SCHEME=thinktank
