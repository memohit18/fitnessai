# Copy to .env and fill in values for local development

EXPO_PUBLIC_APP_ENV=development
# FitForge / ThinkTank service (same as desktop SERVICE_API_URL)
EXPO_PUBLIC_API_URL=https://service.algoarena.co.in
EXPO_PUBLIC_AUTH_API_URL=https://auth.algoarena.co.in
EXPO_PUBLIC_API_TIMEOUT_MS=30000
EXPO_PUBLIC_AUTH_SCHEME=thinktank

# App version gate (optional local fallback; prefer GET {API}/mobile/app-version)
# EXPO_PUBLIC_MIN_APP_VERSION=1.0.0
# EXPO_PUBLIC_LATEST_APP_VERSION=1.0.0
# EXPO_PUBLIC_IOS_STORE_URL=https://apps.apple.com/app/idXXXXXXXX
# EXPO_PUBLIC_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.thinktank.mobile

# Native Google Sign-In (required for iOS/Android dev builds)
# From GoogleService-Info.plist → CLIENT_ID
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
# From Google Cloud Console → Web OAuth client (needed for iOS idToken)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# From GoogleService-Info.plist → REVERSED_CLIENT_ID
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.YOUR_REVERSED_CLIENT_ID
